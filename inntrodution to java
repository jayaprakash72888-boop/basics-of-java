variables rules
1. Must start with a letter, underscore (_) or dollar sign ($).
2. Cannot start with a number.
3. Cannot contain spaces.
4. Special characters are not allowed, except _ and $.
5. Java keywords cannot be used as variable names.
6. Variable names are case-sensitive.
7. Can contain letters, digits, underscores and dollar signs after the first character.
8. Variable names can be of any length.


Method Explanation

| Scanner method   | Example     | Return type |
| ---------------- | ----------- | ----------- |
| nextInt()        | 25          | int         |
| nextLong()       | 9876543210L | long        |
| nextFloat()      | 85.5f       | float       |
| nextDouble()     | 25000.75    | double      |
| next()           | Vehu        | String      |
| nextLine()       | Hello Java  | String      |
| next().charAt(0) | A           | char        |
| nextBoolean()    | true        | boolean     |


import java.util.Scanner;

public class firstpro {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int age;
        String name;
        float marks;
        char result;
        long total_marks;

        System.out.print("Enter age: ");
        age = sc.nextInt();
        sc.nextLine();

        System.out.print("Enter name: ");
        name = sc.nextLine();

        System.out.print("Enter marks: ");
        marks = sc.nextFloat();

        System.out.print("Enter grade: ");
        result = sc.next().charAt(0);

        System.out.print("Enter total marks: ");
        total_marks = sc.nextLong();

        System.out.println("\n--- Student Details ---");
        System.out.println("Age: " + age);
        System.out.println("Name: " + name);
        System.out.println("Marks: " + marks);
        System.out.println("Grade: " + result);
        System.out.println("Total Marks: " + total_marks);

        sc.close();
    }
}
